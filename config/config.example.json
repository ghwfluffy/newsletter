{
  "imap": {
    "host": "imap.example.org",
    "port": 993,
    "username": "newsletter@example.org",
    "password": "CHANGE_ME",
    "filter_recipient": "newsletter@example.org"
  },
  "smtp": {
    "host": "smtp.example.org",
    "port": 587,
    "username": "newsletter@example.org",
    "password": "CHANGE_ME",
    "from": "Newsletter <newsletter@example.org>"
  },
  "db": {
    "db_path": "${config}/list.db"
  },
  "web": {
    "bind": "0.0.0.0",
    "port": 443,
    "domain": "newsmail.spjinc.org",
    "tls_cert": "${config}/tls/${domain}/fullchain.pem",
    "tls_key": "${config}/tls/${domain}/privkey.pem",
    "public_base_url": "https://newsmail.spjinc.org",
    "token_secret": "CHANGE_ME_TO_A_RANDOM_SECRET",
    "unsubscribe_path": "/unsub",
    "manage_path": "/manage",
    "confirmation_email_enabled": false,
    "admin_user": "admin",
    "admin_pass_bcrypt": "$2b$12$JHB/zhIU.GoZEf6RN6y72.eeekabVbb47fFOJkp40B23WsRTxcwOC"
  },
  "relay": {
    "poll_seconds": 30,
    "batch_size": 50,
    "per_recipient_sleep_seconds": [25, 40],
    "per_message_sleep_seconds": [5, 12],
    "between_batches_sleep_seconds": [300, 900],
    "postfix_log_dir": ""
  },
  "test": {
    "enabled": false,
    "contacts": ["test@example.org"],
    "test_db": "${config}/test.db",
    "filter_recipient": "testsender@example.org"
  }
}
